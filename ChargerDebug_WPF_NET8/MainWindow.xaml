<Window x:Class="ChargerDebugApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PKG Battery – Charger Controller Debug" Height="900" Width="1400"
        Background="#E2E8F0" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
    
    <Window.Resources>
        <!-- Engineering Style GroupBox: Clear boundaries and distinct headers -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="0,0,0,1" CornerRadius="4,4,0,0" Padding="12,8">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold" TextElement.Foreground="#0F172A" TextElement.FontSize="13"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Strong Input Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,4,10,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <EventSetter Event="TextChanged" Handler="ConfigTextBox_TextChanged"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,4,10,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Labels -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Buttons with solid borders -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Primary Action Button -->
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Connection Bar -->
            <RowDefinition Height="*"/>    <!-- Tabs -->
            <RowDefinition Height="Auto"/> <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- STANDARD MENU BAR -->
        <Menu Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="Load Configuration..."/>
                <MenuItem Header="Save Configuration..."/>
                <Separator/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Live Monitor (SCADA)..." Click="OpenMonitor_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊" Margin="0,-2,0,0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Serial Terminal Log"/>
                <Separator/>
                <MenuItem Header="Device Calibration"/>
                <Separator/>
                <MenuItem Header="MCU Firmware Update (OTA)..." Click="OpenMcuFirmwareUpdate_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⚡" Margin="0,-2,0,0"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Show ToolBar" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Show StatusBar" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for Updates..."/>
                <MenuItem Header="Documentation"/>
                <Separator/>
                <MenuItem Header="About Charger Debug App"/>
            </MenuItem>
        </Menu>

        <!-- QUICK ACTION TOOLBAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                <!-- Connection -->
                <TextBlock Text="Port:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbMainPort" Width="110" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="Refresh" Click="BtnRefresh_Click" Height="30" Width="85" Padding="0" Margin="0,0,6,0"/>
                <Button x:Name="btnMainConnect" Content="Connect" Style="{StaticResource PrimaryButton}" Height="30" Width="105" Padding="0" Click="BtnMainConnect_Click" Margin="0,0,12,0"/>
                
                <Rectangle Width="1" Height="22" Fill="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                
                <!-- Config Actions -->
                <Button Content="Import Config" Height="30" Padding="14,0" Margin="0,0,6,0" Click="ImportConfig_Click"/>
                <Button Content="Export Config" Height="30" Padding="14,0" Margin="0,0,6,0" Click="ExportConfig_Click"/>
                <Button x:Name="btnReadMcu" Content="Read MCU" Style="{StaticResource PrimaryButton}" Height="30" Padding="14,0" Margin="6,0,6,0" Click="BtnReadMcu_Click"/>
                <Button x:Name="btnWriteMcu" Content="Write MCU" Background="#10B981" Foreground="White" BorderBrush="#059669" Height="30" Padding="14,0" Margin="0,0,6,0" Click="BtnWriteMcu_Click"/>
                <Button Content="Defaults" Height="30" Padding="14,0" Margin="0,0,12,0" Click="Defaults_Click"/>
                
                <Rectangle Width="1" Height="22" Fill="#CBD5E1" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <!-- SCADA Monitor -->
                <Button Content="📊 Live Monitor (SCADA)" Height="30" Padding="16,0" Margin="0" Background="#10B981" Foreground="White" BorderBrush="#059669" Click="OpenMonitor_Click"/>
            </StackPanel>
        </Border>

        <!-- MAIN TABS -->
        <TabControl Grid.Row="2" Margin="8" Background="#F8FAFC" BorderBrush="#94A3B8" BorderThickness="1">
            
            <!-- CHARGE CONFIG TAB -->
            <TabItem Header="Charge Config">
                <Grid Margin="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <GroupBox Header="General Limits">
                                    <StackPanel>
                                        <GroupBox Header="Pack Parameters">
                                            <UniformGrid Columns="4">
                                                <StackPanel Margin="0,5"><TextBlock Text="Battery Cap (Ah)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.BatteryCapacityAh, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Temp Limit (C)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.TempLimitC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="V Min (V)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.VMinV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="V Max (V)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.VMaxV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Min (C)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.IMinC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Max (C)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.IMaxC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Max (A)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.IMaxA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <TextBlock Text=""/>
                                            </UniformGrid>
                                        </GroupBox>
                                        <GroupBox Header="Charge Window (Precharge / Recovery)">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,5"><TextBlock Text="V Low (V)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.VLowV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Low (C)" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ILowC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            </UniformGrid>
                                        </GroupBox>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Charging Strategy">
                                    <StackPanel>
                                        
                                        <GroupBox Header="Cell Voltage Stages">
                                            <StackPanel>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="Enabled" IsChecked="{Binding Config.CellVoltEnabled, Mode=TwoWay}" Margin="0,0,30,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Delta t (s):" Style="{StaticResource LabelStyle}"/>
                                                        <TextBox Text="{Binding Config.CellVoltDeltaTS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Thresholds Header -->
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Cell Vol 1" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Cell Vol 2" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Cell Vol 3" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Cell Vol 4" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Cell Vol 5" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    
                                                    <!-- Thresholds Inputs -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Thresholds" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.CellVolt1V, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Config.CellVolt2V, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Config.CellVolt3V, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Config.CellVolt4V, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Config.CellVolt5V, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <!-- Currents Header -->
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Current 1-2" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Current 2-3" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Current 3-4" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Current 4-5" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    
                                                    <!-- Currents Inputs -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Limits" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.CellCurr1C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Config.CellCurr2C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Config.CellCurr3C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Config.CellCurr4C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>
                                        
                                        <GroupBox Header="Temperature Stages">
                                            <StackPanel>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="Enabled" IsChecked="{Binding Config.TempEnabled, Mode=TwoWay}" Margin="0,0,30,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Delta (C):" Style="{StaticResource LabelStyle}"/>
                                                        <TextBox Text="{Binding Config.TempDeltaC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Thresholds Header -->
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Temperature 1" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Temperature 2" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Temperature 3" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Temperature 4" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="Temperature 5" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    
                                                    <!-- Thresholds Inputs -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Thresholds" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.Temp1C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Config.Temp2C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Config.Temp3C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Config.Temp4C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Config.Temp5C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <!-- Currents Header -->
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Current 1-2" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Current 2-3" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Current 3-4" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Current 4-5" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    
                                                    <!-- Currents Inputs -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Limits" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.TempCurr1C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Config.TempCurr2C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Config.TempCurr3C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Config.TempCurr4C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="SOC Stages">
                                            <StackPanel>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox Content="Enabled" IsChecked="{Binding Config.SocEnabled, Mode=TwoWay}" Margin="0,0,30,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Delta t (s):" Style="{StaticResource LabelStyle}"/>
                                                        <TextBox Text="{Binding Config.SocDeltaTS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                                    </StackPanel>
                                                </Border>
                                                
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Thresholds Header -->
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="SOC 1" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="SOC 2" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="SOC 3" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="SOC 4" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="5" Text="SOC 5" Foreground="#0284C7" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    
                                                    <!-- Thresholds Inputs -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Thresholds" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.Soc1Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Config.Soc2Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Config.Soc3Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Config.Soc4Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding Config.Soc5Pct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <!-- Currents Header -->
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Current 1-2" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Current 2-3" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Current 3-4" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Current 4-5" Foreground="#7C3AED" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                                                    
                                                    <!-- Currents Inputs -->
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current Limits" Style="{StaticResource LabelStyle}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.SocCurr1C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Config.SocCurr2C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Config.SocCurr3C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Config.SocCurr4C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                        </GroupBox>

                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <GroupBox Header="Protection and Hardware">
                                    <StackPanel>
                                        <GroupBox Header="System Mapping">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,5"><TextBlock Text="Device ID:" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="15"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Hardware Version:" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.HwRev, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Charge Source:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox SelectedIndex="{Binding ChargeSourceMode, Mode=TwoWay}">
                                                        <ComboBoxItem>BMS Controlled</ComboBoxItem>
                                                        <ComboBoxItem>Standalone (No BMS)</ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="BMS CAN ID:" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.CanBatteryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBmsIdEnabled}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Admin PIN:" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.AdminPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <TextBlock Text=""/>
                                            </UniformGrid>
                                        </GroupBox>
                                        
                                        <GroupBox Header="Charge Jack Protection">
                                            <UniformGrid Columns="2">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Config.ProtectJackChargeEnabled, Mode=TwoWay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0"/> <TextBlock Text=""/>
                                                <StackPanel Margin="0,5"><TextBlock Text="Delta V (V):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackChargeDeltaV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Delay (s):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackChargeDelayS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            </UniformGrid>
                                        </GroupBox>

                                        <GroupBox Header="Jack Temperature Protection">
                                            <UniformGrid Columns="2">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Config.ProtectJackTempEnabled, Mode=TwoWay}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5,0"/> <TextBlock Text=""/>
                                                <StackPanel Margin="0,5"><TextBlock Text="Threshold (C):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackTempThresholdC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Trip Temp (C):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackTempTripC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Delta (C):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackTempDeltaC, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Delay (s):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackTempDelayS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Power Limit (%):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ProtectJackTempPowerLimitPct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            </UniformGrid>
                                        </GroupBox>

                                        <GroupBox Header="Charger Module Envelope">
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,5"><TextBlock Text="Module Type:" Style="{StaticResource LabelStyle}"/>
                                                    <ComboBox SelectedIndex="{Binding Config.ModuleType, Mode=TwoWay}">
                                                        <ComboBoxItem>Unknown</ComboBoxItem>
                                                        <ComboBoxItem>EVR_10KW_100A_100V</ComboBoxItem>
                                                        <ComboBoxItem>Maxwell</ComboBoxItem>
                                                        <ComboBoxItem>Lianming</ComboBoxItem>
                                                        <ComboBoxItem>TonHe</ComboBoxItem>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="Source Modules:" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.SourceModuleCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="U Min (V):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ModuleUMinV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="U Max (V):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ModuleUMaxV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Min (A):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ModuleIMinA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                                <StackPanel Margin="0,5"><TextBlock Text="I Max (A):" Style="{StaticResource LabelStyle}"/><TextBox Text="{Binding Config.ModuleIMaxA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                            </UniformGrid>
                                        </GroupBox>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="#0F172A" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="lblStatusPrompt" Text="Ready" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Fill="#334155" Margin="10,2"/>
                    <TextBlock Text="Baudrate: 115200" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse x:Name="elpStatusDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblConnectionStatus" Text="Disconnected" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
