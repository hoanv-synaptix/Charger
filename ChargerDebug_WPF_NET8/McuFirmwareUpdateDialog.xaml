<Window x:Class="ChargerDebugApp.McuFirmwareUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ Cập nhật Firmware MCU" Height="680" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinHeight="620" MinWidth="640"
        Background="#E2E8F0" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style matching MainWindow -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="StandardButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Blue Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabControl Style (Clean Segmented Bar, no cut-off / sliced borders) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Segmented Tab Header Bar -->
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <!-- Tab Content -->
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Tabs Content -->
            <RowDefinition Height="Auto"/> <!-- Progress / Status Box -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CẬP NHẬT FIRMWARE MCU" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Quản lý nạp firmware trực tiếp qua cáp USB hoặc từ xa qua mạng 4G Cloud" FontSize="11" Foreground="#64748B"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="BadgeSafe" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSafeStatus" Text="🟢 IDLE - SẴN SÀNG" FontWeight="SemiBold" FontSize="11" Foreground="#166534"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Tabs -->
        <TabControl x:Name="TabControlMain" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" SelectionChanged="TabControlMain_SelectionChanged">
            <!-- TAB 1: NẠP QUA CÁP USB -->
            <TabItem Header="💾 Nạp qua cáp USB (Khuyên dùng)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,0">
                        <!-- Card 1: Thông tin chip MCU hiện tại -->
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phiên bản đang chạy:" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0 (65536)" Style="{StaticResource ValueStyle}" FontSize="13" Foreground="#2563EB" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Trạng thái Bootloader:" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock x:Name="TxtOtaStatus" Text="IDLE (Sẵn sàng)" Style="{StaticResource ValueStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="BtnRefreshStatus" Content="🔄 Đọc lại" Style="{StaticResource StandardButton}" VerticalAlignment="Center" Click="BtnRefreshStatus_Click"/>
                            </Grid>
                        </Border>

                        <!-- Card 2: Chọn file và nạp -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Chọn tệp Firmware mới (.bin):" Style="{StaticResource CardHeader}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtBinFilePath" IsReadOnly="True" Background="#F8FAFC" Padding="8,5" Margin="0,0,8,0" VerticalContentAlignment="Center" BorderBrush="#94A3B8"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseBin" Content="📁 Chọn file..." Style="{StaticResource StandardButton}" Click="BtnBrowseBin_Click"/>
                                </Grid>

                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Kích thước:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtSelectedFileSize" Text="Chưa chọn file" Style="{StaticResource ValueStyle}"/>

                                        <TextBlock Grid.Column="2" Text="Mã CRC32:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="3" x:Name="TxtSelectedFileCrc" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </Grid>
                                </Border>

                                <Button x:Name="BtnStartUsbUpload" Content="🚀 Bắt đầu Nạp Firmware vào MCU" Style="{StaticResource PrimaryButton}" Height="38" Click="BtnStartUsbUpload_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Hướng dẫn nạp USB an toàn -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="📌 Hướng dẫn Nạp Firmware An toàn:" Style="{StaticResource CardHeader}"/>
                                <TextBlock Text="1. Đảm bảo trạm sạc đang dừng hoạt động (trạng thái IDLE)." FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBlock Text="2. Chọn file Charger.bin đã biên dịch (kích thước tối đa 120 KB)." FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                                <TextBlock Text="3. Bấm nút 'Bắt đầu Nạp'. Firmware sẽ được nạp qua USB vào Flash đệm SPI W25Q128 và kiểm tra mã CRC32 trước khi Bootloader nạp vào chip STM32." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CẬP NHẬT QUA 4G -->
            <TabItem Header="🌐 Cập nhật qua 4G (Cloud)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,4,0">
                        <!-- Card 1: Thao tác & Đối soát Phiên bản Firmware qua 4G -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cập nhật trực tuyến từ xa qua 4G Cloud:" Style="{StaticResource CardHeader}" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtFwCheckTimestamp" Text="Chưa kiểm tra" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Hàng 1: Hai nút Thao tác Chính -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnCheckNow4G" Content="🌐 Kiểm tra bản mới (4G)" Style="{StaticResource PrimaryButton}" Height="36" Click="BtnCheckNow4G_Click"/>
                                    <Button Grid.Column="2" x:Name="BtnApply4G" Content="⚡ Áp dụng &amp; Khởi động lại" Style="{StaticResource StandardButton}" Height="36" Click="BtnApply4G_Click"/>
                                </Grid>

                                <!-- Hàng 2: Bảng Đối soát Phiên bản Ngay Dưới Nút Bấm -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Bản đang chạy trên MCU:" Style="{StaticResource LabelStyle}"/>
                                            <TextBlock x:Name="Txt4gCurrentFw" Text="v2.0.0" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Bản mới nhất trên Cloud:" Style="{StaticResource LabelStyle}"/>
                                            <TextBlock x:Name="Txt4gCloudFw" Text="Chưa kiểm tra" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" x:Name="BorderFwCheckResult" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Kết luận kiểm tra:" Style="{StaticResource LabelStyle}"/>
                                            <TextBlock x:Name="TxtFwCheckSummary" Text="Chưa kiểm tra (Bấm nút kiểm tra)" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Hàng 3: Cấu hình Auto-OTA -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkAutoPolicy" Content="Bật tự động kiểm tra bản mới khi máy ở trạng thái rảnh (IDLE)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Chu kỳ kiểm tra:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Grid.Column="1" x:Name="TxtIntervalHours" Text="6" TextAlignment="Center" Padding="2"/>
                                            <TextBlock Grid.Column="2" Text="giờ" Style="{StaticResource LabelStyle}" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Manifest URL:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Grid.Column="1" x:Name="TxtManifestUrl" Text="https://charger-ota.hoanvh-mta.workers.dev/manifest" Padding="4,2"/>
                                        </Grid>
                                        <Button x:Name="BtnSavePolicy" Content="💾 Lưu cấu hình Auto-OTA" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" Padding="14,6" Margin="0,4,0,2" Click="BtnSavePolicy_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Trạng thái Module SIM 4G thực tế từ MCU -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trạng thái Kỹ thuật Module SIM 4G (Từ MCU):" Style="{StaticResource CardHeader}" Margin="0"/>
                                    <Button Grid.Column="1" x:Name="BtnQuery4G" Content="🔄 Đọc lại 4G" Style="{StaticResource StandardButton}" Padding="8,3" Click="BtnQuery4G_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Nguồn 4G: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gPower" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Thẻ SIM: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gSim" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Sóng 4G: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gSignal" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Mạng LTE: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gNet" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="IP: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gIp" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Model: " Style="{StaticResource LabelStyle}"/>
                                        <TextBlock x:Name="Txt4gModel" Text="--" Style="{StaticResource ValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 3. Progress / Status Box -->
        <Border Grid.Row="2" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtProgressTitle" Text="Tiến trình:" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPercent" Text="0%" FontWeight="Bold" FontSize="11" Foreground="#2563EB"/>
                </Grid>
                <ProgressBar x:Name="ProgressBarUpload" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtLogMessage" Text="Hệ thống sẵn sàng." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 4. Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="* Khuyến nghị: Sử dụng tab 'Nạp qua cáp USB' khi đang kết nối trực tiếp với máy tính." FontSize="11" FontStyle="Italic" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Đóng" Style="{StaticResource StandardButton}" Width="90" Height="28" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
